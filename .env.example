# ─────────────────────────────────────────────────────────────
# 30X Trend Intelligence Engine — variables de entorno
# Copia este archivo a .env.local y completa lo que tengas.
# Ninguna clave es obligatoria para arrancar: cada fuente que no
# tenga credenciales se desactiva y lo reporta en la respuesta.
# ─────────────────────────────────────────────────────────────

# ── Motor de IA (Autopsia 5D, Matriz JEV, Adaptador ADN) ──
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# gemini-2.5-flash ya no está disponible para cuentas nuevas: usar el Flash vigente.
GEMINI_MODEL=gemini-3.8-flash

# ── Fuente 1: YouTube Data API v3 (Outlier Score real) ──
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=

# ── Fuente 2: Social SERP (índices públicos LinkedIn / IG / TikTok) ──
# Proveedor principal: https://app.tavily.com
TAVILY_API_KEY=
# Fallback: Google Programmable Search (https://programmablesearchengine.google.com)
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=

# ── Fuente 3: Sensor de Comunidad 30X (lectura de URLs públicas) ──
# Jina Reader: SOLO para artículos de la web abierta (nunca LinkedIn/Instagram/TikTok).
# Funciona sin clave (con límite de uso); con clave sube el límite.
JINA_API_KEY=
# Opcional: token de app Meta para oEmbed de Instagram (APP_ID|CLIENT_TOKEN)
META_OEMBED_TOKEN=

# ── Persistencia ──
# Si están vacías, el motor usa SQLite local en ./.data/trends.db automáticamente.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Ruta del fallback local (opcional)
SQLITE_PATH=./.data/trends.db

# ── Plug & Play 30X (Fase 3) ──
SLACK_WEBHOOK_URL=
NOTION_API_KEY=
NOTION_DATABASE_ID=
MAKE_WEBHOOK_URL=

# Secreto para llamadas externas a /api/analyze-url (Slack Workflow, Make, Zapier…).
# Si está definido, las llamadas que no vienen de la propia UI deben enviar: Authorization: Bearer <secreto>
INGEST_WEBHOOK_SECRET=

# Score JEV mínimo para generar guiones (ahorra costo de IA)
JEV_ADAPT_THRESHOLD=55

# ── Demo pública ──
# Si publicas la app en una URL, define un código: sin él, cualquiera podría gastar tu cuota diaria de APIs.
DEMO_ACCESS_CODE=
